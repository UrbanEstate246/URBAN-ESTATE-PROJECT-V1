# ==========================================
# UrbanEstate / RealEstate Environment Setup
# ==========================================

# 1. MongoDB Database Connection (MongoDB Atlas free cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/urbanestate?retryWrites=true&w=majority

# 2. Authentication Secret (Any long random string)
JWT_SECRET=urbanestate_super_secret_jwt_key_2026

# 3. Cloudinary Configuration (For Property Images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 4. Email / OTP Notifications (Optional - Gmail App Password)
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_email_app_password
