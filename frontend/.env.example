# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# SMS (Phase 2)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=URBANESTATE
